DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascure?schema=public"
JWT_SECRET="change-me-for-local-development"
PORT=3000
OPERATIONAL_VISIT_OVERDUE_HOURS=24
# Gotenberg docx->PDF service (local Docker, 127.0.0.1 only). Visual Report feature.
GOTENBERG_URL=http://127.0.0.1:3002

# Auto "TIDAK PATUH GROUND CLEARANCE" (QR AUTO rule) on submit / office edits.
# Off until the one-time backfill (prisma/scripts/backfill-ground-clearance.ts) is reviewed + run.
# AUTO_GROUND_CLEARANCE=true

# Google Sheet repair-date sync (docs/PLAN-google-sheet-repair-sync.md): path to the Google
# service-account key (JSON, keep it outside the repo). Unset = the feature is off.
# SHEET_SYNC_KEY_FILE=/opt/ascure/secrets/google-sheet-sync.json
# SHEET_SYNC_NIGHTLY=false   # skip the 22:00 MYT run (manual runs still work)
