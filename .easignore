# EAS builds upload an archive of the project context. When EAS is run from
# the repository root in this monorepo, the context includes sibling apps too,
# so mobile builds need explicit filtering before archive creation.
#
# Keep mobile source, native project files, workspace manifests, patches, and
# shared packages uploadable. Do not add broad ignores for apps/mobile,
# packages, pnpm-workspace.yaml, pnpm-lock.yaml, or patches.

# Dependency folders are restored on the EAS builder and should not be uploaded.
node_modules/
apps/admin-web/node_modules/
apps/api/node_modules/

# Git history is not needed in the EAS archive.
.git/

# Local environment files. Keep the committed example at the repository root.
.env
.env.*
!/.env.example

# OS/editor noise.
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and coverage reports are local diagnostics, not production mobile inputs.
*.log
coverage/

# Generic generated output and transient cache directories.
dist/
build/
.tmp/
.temp/
.cache/
tmp/
temp/

# Admin Next.js output must never be uploaded to EAS for mobile builds.
# .next contains transient dev/server/app file traces from the web app; stale
# entries can disappear between Next dev/build runs and make EAS archive upload
# fail with ENOENT before the mobile build starts.
apps/admin-web/.next/
apps/admin-web/out/

# API and older web admin generated outputs are rebuilt by their own workflows.
apps/api/dist/
apps/web-admin/dist/

# Local Expo state is regenerated by Expo tooling.
.expo/
apps/mobile/.expo/

# Local/runtime storage is unrelated to compiling the mobile app.
prisma/dev.db
.local-postgres/
data/
nginx/certbot/
uploads/
apps/api/uploads/

# Root npm lockfile is intentionally ignored because this workspace is pinned
# by packageManager=pnpm and pnpm-lock.yaml, which must remain uploadable.
package-lock.json
apps/*/pnpm-lock.yaml
