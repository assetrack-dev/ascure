  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([inspectionId, createdAt])
  @@index([templateItemId])
}

model InspectionItemResult {
  id                  String                    @id @default(uuid()) @db.Uuid
  inspectionId        String                    @db.Uuid
  checklistItemId     String?                   @db.Uuid
  label               String
  result              InspectionItemResultValue
  remark              String?
  isDefect            Boolean                   @default(false)
  isEmergency         Boolean                   @default(false)
  severity            DefectSeverity?
  // Denormalized from the template item at save (mirrors severity/isEmergency)
  // so every defect-creation path can stamp the defect without a re-lookup.
  maintenanceCategory MaintenanceCategory?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  inspection          Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defect              Defect?

  @@index([inspectionId])
  @@index([checklistItemId])
}

model Defect {
  id                        String                 @id @default(uuid()) @db.Uuid
  inspectionItemResultId    String                 @unique @db.Uuid
  assignedUserId            String?                @db.Uuid
  assignedTeamId            String?                @db.Uuid
  assignedToUserId          String?                @db.Uuid
  assignedToTeamId          String?                @db.Uuid
  verifiedByUserId          String?                @db.Uuid
  maintainedByUserId        String?                @db.Uuid
  closureVerifiedByUserId   String?                @db.Uuid
  // The maintenance company this defect was routed to on release (maintenance
  // handoff Phase 3). Stamped from the MAINHEAD's registered maintenance org at
  // LAPORAN SELESAI (emergencies at inspection submit). Grants the maintenance
  // company's users cross-company visibility of their pool (Phase 4) even when
  // they are not on the inspecting team. Null = not yet released / no registry.
  maintenanceOrganizationId String?                @db.Uuid
  status                    DefectStatus           @default(OPEN)
  severity                  DefectSeverity         @default(MEDIUM)
  // Work-type for maintenance packaging/filtering, stamped at materialization
  // from the item result (null on legacy rows = treated as SELENGGARAAN).
  maintenanceCategory       MaintenanceCategory?
  isEmergency               Boolean                @default(false)
  lifecycleStatus           DefectLifecycleStatus?
  resolutionOutcome         ResolutionOutcome?
  actionRemark              String?
  dueDate                   DateTime?
  resolvedAt                DateTime?
  closedAt                  DateTime?
  assignedAt                DateTime?
  verifiedAt                DateTime?
  maintainedAt              DateTime?
  verificationRemarks       String?
  verificationNotes         String?
  maintenanceNotes          String?
  closureVerifiedAt         DateTime?
  closureRemarks            String?
  closureVerificationNotes  String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  inspectionItemResult      InspectionItemResult   @relation(fields: [inspectionItemResultId], references: [id], onDelete: Cascade)
  assignedUser              User?                  @relation("DefectAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeam              Team?                  @relation("DefectAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedToUser            User?                  @relation("DefectAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToTeam            Team?                  @relation("DefectAssignedToTeam", fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  verifiedByUser            User?                  @relation("DefectVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  maintainedByUser          User?                  @relation("DefectMaintainedByUser", fields: [maintainedByUserId], references: [id], onDelete: SetNull)
  closureVerifiedByUser     User?                  @relation("DefectClosureVerifiedByUser", fields: [closureVerifiedByUserId], references: [id], onDelete: SetNull)
  maintenanceOrganization   Organization?          @relation("DefectMaintenanceOrg", fields: [maintenanceOrganizationId], references: [id], onDelete: SetNull)
  evidenceImages            DefectEvidenceImage[]
  timelineEntries           DefectTimelineEntry[]

  @@index([assignedUserId])
  @@index([assignedTeamId])
  @@index([assignedToUserId])
  @@index([assignedToTeamId])
  @@index([verifiedByUserId])
  @@index([maintainedByUserId])
  @@index([closureVerifiedByUserId])
  @@index([maintenanceOrganizationId])
  @@index([lifecycleStatus])
  @@index([resolutionOutcome])
  @@index([assignedAt])
  @@index([maintainedAt])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([isEmergency])
}

model DefectEvidenceImage {
  id              String    @id @default(uuid()) @db.Uuid
  defectId        String    @db.Uuid
  createdByUserId String?   @db.Uuid
  evidenceType    String    @default("MAINTENANCE_PROOF")
  fileName        String
  storageKey      String
  contentType     String?
  sizeBytes       Int?
  url             String?
  note            String?
  latitude        Float?
  longitude       Float?
  timestamp       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  defect          Defect    @relation(fields: [defectId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("DefectEvidenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([defectId])
  @@index([createdByUserId])
  @@index([evidenceType])
  @@index([createdAt])
}

model DefectTimelineEntry {
  id                    String                  @id @default(uuid()) @db.Uuid
  defectId              String                  @db.Uuid
  type                  DefectTimelineEventType
  fromStatus            DefectStatus?
  toStatus              DefectStatus?
  fromLifecycleStatus   DefectLifecycleStatus?
  toLifecycleStatus     DefectLifecycleStatus?
  fromResolutionOutcome ResolutionOutcome?
  toResolutionOutcome   ResolutionOutcome?
  comment               String?
  createdByUserId       String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  defect                Defect                  @relation(fields: [defectId], references: [id], onDelete: Cascade)
  createdBy             User?                   @relation("DefectTimelineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([defectId, createdAt])
  @@index([createdByUserId])
}

model InspectionResult {
  id             String                 @id @default(uuid()) @db.Uuid
  inspectionId   String                 @db.Uuid
  templateItemId String                 @db.Uuid
  valueText      String?
  valueNumber    Decimal?               @db.Decimal(18, 4)
  valueBoolean   Boolean?
  valueDate      DateTime?              @db.Date
  valueDateTime  DateTime?
  valueJson      Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  inspection     Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem   InspectionTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  images         Image[]

  @@unique([inspectionId, templateItemId])
  @@index([templateItemId])
}

model Image {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  siteVisitId        String?           @db.Uuid
  assetId            String?           @db.Uuid
  inspectionId       String?           @db.Uuid
  inspectionResultId String?           @db.Uuid
  createdByUserId    String?           @db.Uuid
  fileName           String
  storageKey         String
  contentType        String?
  url                String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteVisit          SiteVisit?        @relation(fields: [siteVisitId], references: [id], onDelete: SetNull)
  asset              Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspection         Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  inspectionResult   InspectionResult? @relation(fields: [inspectionResultId], references: [id], onDelete: SetNull)
  createdBy          User?             @relation("ImageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([siteVisitId])
  @@index([assetId])
  @@index([inspectionId])
  @@index([inspectionResultId])
}

enum TieEdgeKind {
  NOP
}

enum SwitchState {
  OPEN
  CLOSED
}

// --- Network graph spine (north-star §2-§3; docs/adr/0001-network-graph-storage-model.md) ---

model Feeder {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  substationId String                 @db.Uuid
  code         String
  name         String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  substation   Substation             @relation(fields: [substationId], references: [id], onDelete: Cascade)
  memberships  PoleFeederMembership[]

  @@unique([substationId, code])
  @@index([tenantId])
  @@index([substationId])
}

model PoleFeederMembership {
  id             String   @id @default(uuid()) @db.Uuid
  assetId        String   @db.Uuid
  feederId       String   @db.Uuid
  sequenceIndex  Int
  branchSuffix   String   @default("")
  // The parent pole ON THIS FEEDER (per-feeder topology). A multi-feeder pole has
  // one parent per feeder, so the single Asset.fedFromAssetId can't represent it;
  // this is what the network graph + isolation traverse. Null at the feeder head
  // or when no parent could be resolved.
  fedFromAssetId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  asset          Asset    @relation("PoleMembership", fields: [assetId], references: [id], onDelete: Cascade)
  feeder         Feeder   @relation(fields: [feederId], references: [id], onDelete: Cascade)
  fedFromAsset   Asset?   @relation("MembershipFedFrom", fields: [fedFromAssetId], references: [id], onDelete: SetNull)

  @@unique([feederId, sequenceIndex, branchSuffix])
  @@unique([assetId, feederId])
  @@index([assetId])
  @@index([feederId])
  @@index([fedFromAssetId])
}

model NetworkTieEdge {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  fromAssetId   String      @db.Uuid
  toAssetId     String      @db.Uuid
  kind          TieEdgeKind @default(NOP)
  switchState   SwitchState @default(OPEN)
  deviceAssetId String?     @db.Uuid
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromAsset     Asset       @relation("TieEdgeFrom", fields: [fromAssetId], references: [id], onDelete: Cascade)
  toAsset       Asset       @relation("TieEdgeTo", fields: [toAssetId], references: [id], onDelete: Cascade)
  deviceAsset   Asset?      @relation("TieEdgeDevice", fields: [deviceAssetId], references: [id], onDelete: SetNull)

  @@unique([fromAssetId, toAssetId, kind])
  @@index([tenantId])
  @@index([fromAssetId])
  @@index([toAssetId])
  @@index([deviceAssetId])
}

// Admin-uploaded .docx report template, one active version per (tenant,
// operationalScope). The asset's scope selects which template renders its
// visual report. Versioned: uploading a new one supersedes the prior active.
model ReportTemplate {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  name             String
  operationalScope OperationalScope
  fileName         String
  storageKey       String
  url              String
  version          Int              @default(1)
  isActive         Boolean          @default(true)
  uploadedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
  @@index([tenantId, operationalScope, isActive])
}

// The frozen compiled PDF for a Pencawang survey, produced when it reaches
// LAPORAN SELESAI (cover + each asset's report, merged). Versioned so a
// re-approval after PERLU PINDAAN produces a new immutable record.
model SiteVisitReport {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  siteVisitId      String    @db.Uuid
  version          Int       @default(1)
  fileName         String
  storageKey       String
  url              String
  status           String    @default("COMPLETED")
  compiledByUserId String?   @db.Uuid
  compiledAt       DateTime  @default(now())
  metadata         Json?
  createdAt        DateTime  @default(now())
  siteVisit        SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)

  @@unique([siteVisitId, version])
  @@index([tenantId])
}
