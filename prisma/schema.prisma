model Substation {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @db.Uuid
  // Structural parent: a Pencawang belongs to exactly one MAINHEAD (its Region is
  // derived via Mainhead.operationalRegionId). Drives the hierarchical map's
  // Region -> Mainhead -> Pencawang aggregation. Nullable while backfilling and for
  // Pencawang not yet assigned. See docs/PLAN-hierarchical-map.md.
  mainheadId          String?     @db.Uuid
  name                String
  code                String
  location            String?
  // Stable, human-readable Pencawang reference code = <Mainhead.code><NNNN> (4-digit
  // running number per Mainhead-code prefix within the tenant, e.g. KTN0001). Once
  // assigned it never CHANGES (existing codes are immutable), and mid-sequence gaps
  // are never back-filled. The ONE non-guarantee: if the Pencawang holding the
  // HIGHEST number for a prefix is hard-deleted and a new one is later added, that
  // top number can be reused (rare — deletes are mostly dummy cleanup). Null until
  // the Pencawang has a Mainhead whose code is set. Uniqueness is per-tenant (see
  // the composite @@unique below), matching every other Substation identifier and
  // the per-tenant numbering in reports.service.ensurePencawangRefCodes.
  refCode             String?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mainhead            Mainhead?   @relation(fields: [mainheadId], references: [id], onDelete: SetNull)
  assets              Asset[]
  feeders             Feeder[]
  siteVisits          SiteVisit[]
  fromRouteSiteVisits SiteVisit[] @relation("SiteVisitFromPencawang")
  toRouteSiteVisits   SiteVisit[] @relation("SiteVisitToPencawang")

  @@unique([tenantId, code])
  @@unique([tenantId, refCode])
  @@index([tenantId])
  @@index([mainheadId])
}

/// Append-only audit trail for irreversible hard-deletes (a MANAGER or ADMIN
/// removing a Site Visit or a whole Pencawang + its cascade). Actor identity is
/// denormalised (email/name) so the log survives even if the user is later
/// deleted; there is intentionally NO user FK. tenantId cascades so a tenant
/// teardown still cleans up.
model DeletionLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  actorEmail  String?
  actorName   String?
  entityType  String
  entityId    String   @db.Uuid
  label       String?
  summary     Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

