generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  TECHNICIAN
  VIEWER
  CLIENT
}

enum MainheadAccessRole {
  ENGINEER
  SENIOR_TECHNICIAN
  FOREMAN
  VIEWER
}

enum SiteVisitStatus {
  OPEN
  IN_PROGRESS
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SiteVisitType {
  DISCOVERY
  REINSPECTION
  SPECIAL
  AUDIT
}

enum SiteVisitValidationStatus {
  PENDING
  VALIDATED
  WARNING
  FAILED
}

// The one PE-survey lifecycle (north-star §4). Lives on the per-PE, per-cycle
// SiteVisit — the "cycle survey". Replaces the OperationalSession governance
// machine and absorbs the survey-level "reject" (PERLU PINDAAN) that the old
// defect-QA flow used to own.
//
// Review chain (technician/supervisor → MANAGER → DC):
//   DALAM_RONDAAN
//     → RONDAAN_SELESAI       (field crew finished + submitted; pending manager review)
//       → DISAHKAN_PENGURUS   (the team's MANAGER approved; pending DC checking)
//       ⟲ PERLU_PINDAAN       (manager sent it back to the crew to amend)
//     DISAHKAN_PENGURUS
//       → LAPORAN_SELESAI      (DC checked + generated the report)
//       ⟲ PERLU_PINDAAN        (DC sent it back to the crew to amend)
//     LAPORAN_SELESAI → ARKIB
//   PERLU_PINDAAN → RONDAAN_SELESAI (crew re-submits; re-enters manager review)
enum SurveyLifecycleStatus {
  DALAM_RONDAAN
  RONDAAN_SELESAI
  DISAHKAN_PENGURUS
  PERLU_PINDAAN
  PINDAAN_SELESAI
  LAPORAN_SELESAI
  ARKIB
}

enum InspectionTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InspectionTemplateScopeLevel {
  GLOBAL
  ORGANIZATION
  OPERATIONAL_REGION
  BRANCH
  MAINHEAD
}

enum InspectionItemInputType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  JSON
  SELECT
  MULTI_SELECT
  IMAGE
  GPS
  READING
  // Smart Sensor capture (SAVR/SAVT ground clearance): a photo (saved as
  // timestamped evidence + linked to this result) plus an OCR'd numeric reading.
  OCR
}

enum InspectionCompletionStatus {
  DRAFT
  SUBMITTED
}

enum InspectionItemResultValue {
  PASS
  FAIL
  NA
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  MONITORING
  RESOLVED
  CLOSED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectLifecycleStatus {
  DETECTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFICATION_PENDING
  CLOSED
}

// Maintenance work-type a defect is dispatched under. RENTIS (line clearing) and
// CAT_TIANG (pole painting) are each defined by tagging specific checklist
// item(s); everything else defaults to SELENGGARAAN (general maintenance). The
// maintenance company filters/packages its routed pool by this. Fixed set for
// now (TNB LV survey); productize to a tenant list later.
enum MaintenanceCategory {
  RENTIS
  CAT_TIANG
  SELENGGARAAN
}

enum ResolutionOutcome {
  REPAIRED
  EXTERNAL_CONSTRAINT
  PARTIAL
  DEFERRED
  MONITOR_ONLY
  ESCALATED
  RESOLVED
  TEMPORARY_FIX
  MONITORING_REQUIRED
  DUPLICATE
  FALSE_POSITIVE

  @@map("DefectResolutionOutcome")
}

enum DefectTimelineEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  DUE_DATE_CHANGED
  COMMENT
  DEFECT_VERIFIED
  DEFECT_ASSIGNED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  RESOLUTION_OUTCOME_UPDATED
  CLOSURE_VERIFIED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  NOT_FOUND
  REMOVED
  DUPLICATE
}

enum OrganizationType {
  ASCURE
  TNB
  MAIN_CONTRACTOR
  SUBCONTRACTOR
  CLIENT
}

enum OperationalDomain {
  SURVEY
  INSPECTION
  MAINTENANCE
  REPAIR
  AUDIT
  CIVIL
  DISTRIBUTION
  THIRTY_THREE_KV
  EMERGENCY
  OTHER
}

enum OperationMode {
  INSPECTION
  MAINTENANCE
}

enum OperationalScope {
  SAVR
  SAVT
  PENCAWANG
  FEEDER_PILLAR
  CABLE_BRIDGE
  LINK_BOX
}

enum SessionKind {
  PENCENTRIC
  ROUTE
  STANDALONE
}

enum OperationalSessionScope {
  SAVR
  SAVT
  PENCAWANG
  FEEDER_PILLAR
  LINK_BOX
  CABLE_BRIDGE
}

enum OperationalSessionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  QA_REVIEW
  AMENDMENT_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum OrganizationCapabilityType {
  SURVEY
  INSPECTION
  MAINTENANCE
  REPAIR
  CIVIL
  DISTRIBUTION
  THIRTY_THREE_KV
  EMERGENCY_RESPONSE
  QA_VALIDATION
  REPORTING
  OTHER
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MANAGER
  SUPERVISOR
  TECHNICIAN
  VIEWER
  CLIENT_VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectMembershipRole {
  PROJECT_MANAGER
  PROJECT_SUPERVISOR
  FIELD_LEAD
  FIELD_TECHNICIAN
  QA_VALIDATOR
  CLIENT_REVIEWER
  VIEWER
}

enum WorkPackageStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkPackageAssignmentRole {
  PRIMARY_CONTRACTOR
  SUPPORT_CONTRACTOR
  QA_REVIEWER
  CLIENT_OBSERVER
}

enum SiteVisitParticipantRole {
  LEAD
  MEMBER
  SUPERVISOR
  QA_VALIDATOR
  OBSERVER
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  code                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  departments         Department[]
  teams               Team[]
  users               User[]
  substations         Substation[]
  assetTypes          AssetType[]
  assets              Asset[]
  siteVisits          SiteVisit[]
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  operationalSessions OperationalSession[]
  images              Image[]
  operationalRegions  OperationalRegion[]
  feeders             Feeder[]
  networkTieEdges     NetworkTieEdge[]
  organizations       Organization[]
  deletionLogs        DeletionLog[]
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams     Team[]
  users     User[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Team {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  departmentId          String?          @db.Uuid
  organizationId        String?          @db.Uuid
  branchId              String?          @db.Uuid
  mainheadId            String?          @db.Uuid
  name                  String
  code                  String
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department            Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organization          Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch                Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  mainhead              Mainhead?        @relation(fields: [mainheadId], references: [id], onDelete: SetNull)
  members               TeamMember[]
  siteVisits            SiteVisit[]
  assignedDefects       Defect[]         @relation("DefectAssignedTeam")
  assignedToDefects     Defect[]         @relation("DefectAssignedToTeam")
  assignedUsers         User[]           @relation("UserOperationalTeam")
  capabilityAssignments TeamCapability[]
  supervisors           TeamSupervisor[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([mainheadId])
}

model User {
  id                        String                        @id @default(uuid()) @db.Uuid
  tenantId                  String                        @db.Uuid
  departmentId              String?                       @db.Uuid
  organizationId            String?                       @db.Uuid
  branchId                  String?                       @db.Uuid
  mainheadId                String?                       @db.Uuid
  teamId                    String?                       @db.Uuid
  email                     String                        @unique
  name                      String
  passwordHash              String
  // Forced password rotation: set true when an admin/manager provisions the
  // account or resets the password (the creator-set password is temporary);
  // cleared when the user changes it via PATCH /auth/change-password.
  mustChangePassword        Boolean                       @default(false)
  role                      UserRole
  isActive                  Boolean                       @default(true)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  // Offline sync gate (ADR 0002 §4): the device's last self-reported pending
  // mutation count + when it reported. Defaults to 0 so the reassign gate is a
  // no-op until the mobile app starts sending heartbeats.
  syncPendingCount          Int                           @default(0)
  syncReportedAt            DateTime?
  // Single-device, "always logged in" mobile session. Holds the id of the
  // currently-active mobile login; each mobile login rotates it, so a token
  // issued to a previously signed-in phone stops validating (one phone per
  // account). Null = no active mobile session. Admin-web logins never touch it.
  mobileSessionId           String?
  tenant                    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department                Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organization              Organization?                 @relation("UserOperationalOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  branch                    Branch?                       @relation("UserOperationalBranch", fields: [branchId], references: [id], onDelete: SetNull)
  mainhead                  Mainhead?                     @relation("UserOperationalMainhead", fields: [mainheadId], references: [id], onDelete: SetNull)
  team                      Team?                         @relation("UserOperationalTeam", fields: [teamId], references: [id], onDelete: SetNull)
  teamMemberships           TeamMember[]
  siteVisitUsers            SiteVisitUser[]
  createdVisits             SiteVisit[]                   @relation("SiteVisitCreatedBy")
  validatedVisits           SiteVisit[]                   @relation("SiteVisitValidatedBy")
  createdAssets             Asset[]                       @relation("AssetCreatedBy")
  siteVisitAssetsAdded      SiteVisitAsset[]              @relation("SiteVisitAssetAddedBy")
  createdInspects           Inspection[]                  @relation("InspectionCreatedBy")
  createdImages             Image[]                       @relation("ImageCreatedBy")
  defectTimelineEntries     DefectTimelineEntry[]         @relation("DefectTimelineCreatedBy")
  assignedDefects           Defect[]                      @relation("DefectAssignedUser")
  assignedToDefects         Defect[]                      @relation("DefectAssignedToUser")
  verifiedDefects           Defect[]                      @relation("DefectVerifiedByUser")
  maintainedDefects         Defect[]                      @relation("DefectMaintainedByUser")
  closureVerifiedDefects    Defect[]                      @relation("DefectClosureVerifiedByUser")
  defectEvidenceImages      DefectEvidenceImage[]         @relation("DefectEvidenceCreatedBy")
  organizationMemberships   OrganizationMembership[]
  projectMemberships        ProjectMembership[]
  siteVisitParticipants     SiteVisitParticipant[]
  capabilityAssignments     UserCapability[]
  mainheadAccesses          UserMainheadAccess[]
  operationalRegionAccesses UserOperationalRegionAccess[]
  assignedQaSessions        OperationalSession[]          @relation("OperationalSessionAssignedQaUser")
  assignedSessionAssets     OperationalSessionAsset[]     @relation("OperationalSessionAssetAssignedBy")
  removedSessionAssets      OperationalSessionAsset[]     @relation("OperationalSessionAssetRemovedBy")
  siteVisitLifecycleEvents  SiteVisitLifecycleEvent[]     @relation("SiteVisitLifecycleCreatedBy")
  supervisedTeams           TeamSupervisor[]

  @@index([tenantId])
  @@index([organizationId])
  @@index([branchId])
  @@index([mainheadId])
  @@index([teamId])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamSupervisor {
  id               String   @id @default(uuid()) @db.Uuid
  teamId           String   @db.Uuid
  supervisorUserId String   @db.Uuid
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  supervisor       User     @relation(fields: [supervisorUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, supervisorUserId])
  @@index([supervisorUserId])
  @@index([teamId])
}

model Organization {
  id                     String                             @id @default(uuid()) @db.Uuid
  name                   String
  code                   String?                            @unique
  type                   OrganizationType
  tenantId               String?                            @db.Uuid
  parentOrganizationId   String?                            @db.Uuid
  isActive               Boolean                            @default(true)
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  tenant                 Tenant?                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentOrganization     Organization?                      @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations     Organization[]                     @relation("OrganizationHierarchy")
  memberships            OrganizationMembership[]
  capabilities           OrganizationCapability[]
  capabilityAssignments  OrganizationCapabilityAssignment[]
  mainheadAssignments    OrganizationMainhead[]
  branches               Branch[]
  teams                  Team[]
  assignedUsers          User[]                             @relation("UserOperationalOrganization")
  maintainedMainheads    Mainhead[]                         @relation("MainheadMaintenanceOrg")
  routedDefects          Defect[]                           @relation("DefectMaintenanceOrg")
  clientProjects         Project[]                          @relation("ProjectClientOrganization")
  workPackageAssignments WorkPackageAssignment[]
  siteVisits             SiteVisit[]
  inspectionTemplates    InspectionTemplate[]
  operationalSessions    OperationalSession[]               @relation("OperationalSessionOrganization")
  assignedSessions       OperationalSession[]               @relation("OperationalSessionAssignedCompany")

  @@index([type])
  @@index([tenantId])
  @@index([parentOrganizationId])
}

model OrganizationCapability {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  capability     OrganizationCapabilityType
  isActive       Boolean                    @default(true)
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capability])
  @@index([organizationId])
  @@index([capability])
}

model Capability {
  id                      String                             @id @default(uuid()) @db.Uuid
  name                    String
  code                    String                             @unique
  description             String?
  isActive                Boolean                            @default(true)
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  assetTypes              AssetType[]
  inspectionTemplates     InspectionTemplate[]
  organizationAssignments OrganizationCapabilityAssignment[]
  branchAssignments       BranchCapability[]
  mainheadAssignments     MainheadCapability[]
  teamAssignments         TeamCapability[]
  userAssignments         UserCapability[]

  @@index([isActive])
}

model OrganizationCapabilityAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  capabilityId   String       @db.Uuid
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capabilityId])
  @@index([organizationId])
  @@index([capabilityId])
  @@index([isActive])
}

// Which MAINHEADs a company (Organization) is responsible for. ADMIN curates this
// set; a MANAGER may then attach only these MAINHEADs to their teams/users. This
// is the company↔MAINHEAD link that does NOT depend on a branch, so it works for
// region-scoped MAINHEADs (branch = null) that belong to no single company via a
// branch. Mirrors OrganizationCapabilityAssignment.
model OrganizationMainhead {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  mainheadId     String       @db.Uuid
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainhead       Mainhead     @relation(fields: [mainheadId], references: [id], onDelete: Cascade)

  @@unique([organizationId, mainheadId])
  @@index([organizationId])
  @@index([mainheadId])
  @@index([isActive])
}

model OrganizationMembership {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String                     @db.Uuid
  organizationId String                     @db.Uuid
  role           OrganizationMembershipRole
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Branch {
  id                    String               @id @default(uuid()) @db.Uuid
  organizationId        String               @db.Uuid
  name                  String
  code                  String?
  region                String?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainheads             Mainhead[]
  teams                 Team[]
  assignedUsers         User[]               @relation("UserOperationalBranch")
  capabilityAssignments BranchCapability[]
  projects              Project[]
  siteVisits            SiteVisit[]
  inspectionTemplates   InspectionTemplate[]
  operationalSessions   OperationalSession[]

  @@index([organizationId])
}

model BranchCapability {
  id           String     @id @default(uuid()) @db.Uuid
  branchId     String     @db.Uuid
  capabilityId String     @db.Uuid
  isActive     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([branchId, capabilityId])
  @@index([branchId])
  @@index([capabilityId])
  @@index([isActive])
}

model OperationalRegion {
  id                  String                        @id @default(uuid()) @db.Uuid
  tenantId            String                        @db.Uuid
  name                String
  code                String
  state               String?
  isActive            Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  tenant              Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mainheads           Mainhead[]
  userAccesses        UserOperationalRegionAccess[]
  inspectionTemplates InspectionTemplate[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([isActive])
}

model Mainhead {
  id                        String                 @id @default(uuid()) @db.Uuid
  branchId                  String?                @db.Uuid
  operationalRegionId       String?                @db.Uuid
  // The maintenance company registered for this MAINHEAD (maintenance handoff
  // Phase 2). At LAPORAN SELESAI a survey's defects release + auto-route to this
  // org's pool; the org (a MAIN_CONTRACTOR/SUBCONTRACTOR) self-assigns internally
  // or subcontracts. One maintainer per MAINHEAD; a company can maintain many.
  maintenanceOrganizationId String?                @db.Uuid
  name                      String
  code                      String?
  description               String?
  isActive                  Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  branch                    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  operationalRegion         OperationalRegion?     @relation(fields: [operationalRegionId], references: [id], onDelete: SetNull)
  maintenanceOrganization   Organization?          @relation("MainheadMaintenanceOrg", fields: [maintenanceOrganizationId], references: [id], onDelete: SetNull)
  teams                     Team[]
  assignedUsers             User[]                 @relation("UserOperationalMainhead")
  userAccesses              UserMainheadAccess[]
  organizationAssignments   OrganizationMainhead[]
  capabilityAssignments     MainheadCapability[]
  substations               Substation[]
  projects                  Project[]
  workPackages              WorkPackage[]
  siteVisits                SiteVisit[]
  inspectionTemplates       InspectionTemplate[]
  operationalSessions       OperationalSession[]

  @@index([branchId])
  @@index([operationalRegionId])
  @@index([maintenanceOrganizationId])
  @@index([isActive])
}

model UserMainheadAccess {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  mainheadId String              @db.Uuid
  accessRole MainheadAccessRole?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainhead   Mainhead            @relation(fields: [mainheadId], references: [id], onDelete: Cascade)

  @@unique([userId, mainheadId])
  @@index([userId])
  @@index([mainheadId])
  @@index([accessRole])
}

model UserOperationalRegionAccess {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  operationalRegionId String              @db.Uuid
  accessRole          MainheadAccessRole?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationalRegion   OperationalRegion   @relation(fields: [operationalRegionId], references: [id], onDelete: Cascade)

  @@unique([userId, operationalRegionId])
  @@index([userId])
  @@index([operationalRegionId])
  @@index([accessRole])
}

model MainheadCapability {
  id           String     @id @default(uuid()) @db.Uuid
  mainheadId   String     @db.Uuid
  capabilityId String     @db.Uuid
  isActive     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mainhead     Mainhead   @relation(fields: [mainheadId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([mainheadId, capabilityId])
  @@index([mainheadId])
  @@index([capabilityId])
  @@index([isActive])
}

model TeamCapability {
  id           String     @id @default(uuid()) @db.Uuid
  teamId       String     @db.Uuid
  capabilityId String     @db.Uuid
  isActive     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([teamId, capabilityId])
  @@index([teamId])
  @@index([capabilityId])
  @@index([isActive])
}

model UserCapability {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  capabilityId String     @db.Uuid
  isActive     Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, capabilityId])
  @@index([userId])
  @@index([capabilityId])
  @@index([isActive])
}

model Project {
  id                   String              @id @default(uuid()) @db.Uuid
  branchId             String?             @db.Uuid
  mainheadId           String?             @db.Uuid
  clientOrganizationId String?             @db.Uuid
  name                 String
  code                 String?             @unique
  description          String?
  status               ProjectStatus       @default(DRAFT)
  operationalDomain    OperationalDomain?
