generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SUPERVISOR
  TECHNICIAN
  VIEWER
  CLIENT
}

enum SiteVisitStatus {
  OPEN
  IN_PROGRESS
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SiteVisitType {
  DISCOVERY
  REINSPECTION
  SPECIAL
  AUDIT
}

enum SiteVisitValidationStatus {
  PENDING
  VALIDATED
  WARNING
  FAILED
}

enum InspectionTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InspectionItemInputType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  JSON
  SELECT
}

enum InspectionCompletionStatus {
  DRAFT
  SUBMITTED
}

enum InspectionItemResultValue {
  PASS
  FAIL
  NA
}

enum DefectStatus {
  OPEN
  IN_PROGRESS
  MONITORING
  RESOLVED
  CLOSED
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DefectLifecycleStatus {
  DETECTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFICATION_PENDING
  CLOSED
}

enum ResolutionOutcome {
  REPAIRED
  EXTERNAL_CONSTRAINT
  PARTIAL
  DEFERRED
  MONITOR_ONLY
  ESCALATED
  RESOLVED
  TEMPORARY_FIX
  MONITORING_REQUIRED
  DUPLICATE
  FALSE_POSITIVE

  @@map("DefectResolutionOutcome")
}

enum DefectTimelineEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  DUE_DATE_CHANGED
  COMMENT
  DEFECT_VERIFIED
  DEFECT_ASSIGNED
  MAINTENANCE_STARTED
  MAINTENANCE_COMPLETED
  RESOLUTION_OUTCOME_UPDATED
  CLOSURE_VERIFIED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  NOT_FOUND
  REMOVED
  DUPLICATE
}

enum OrganizationType {
  ASCURE
  TNB
  SUBCONTRACTOR
  CONSULTANT
  CLIENT
  OTHER
}

enum OperationalDomain {
  SURVEY
  INSPECTION
  MAINTENANCE
  REPAIR
  AUDIT
  CIVIL
  DISTRIBUTION
  THIRTY_THREE_KV
  EMERGENCY
  OTHER
}

enum OrganizationCapabilityType {
  SURVEY
  INSPECTION
  MAINTENANCE
  REPAIR
  CIVIL
  DISTRIBUTION
  THIRTY_THREE_KV
  EMERGENCY_RESPONSE
  QA_VALIDATION
  REPORTING
  OTHER
}

enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MANAGER
  SUPERVISOR
  TECHNICIAN
  VIEWER
  CLIENT_VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectMembershipRole {
  PROJECT_MANAGER
  PROJECT_SUPERVISOR
  FIELD_LEAD
  FIELD_TECHNICIAN
  QA_VALIDATOR
  CLIENT_REVIEWER
  VIEWER
}

enum WorkPackageStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WorkPackageAssignmentRole {
  PRIMARY_CONTRACTOR
  SUPPORT_CONTRACTOR
  QA_REVIEWER
  CLIENT_OBSERVER
}

enum SiteVisitParticipantRole {
  LEAD
  MEMBER
  SUPERVISOR
  QA_VALIDATOR
  OBSERVER
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  code                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  departments         Department[]
  teams               Team[]
  users               User[]
  substations         Substation[]
  assetTypes          AssetType[]
  assets              Asset[]
  siteVisits          SiteVisit[]
  inspectionTemplates InspectionTemplate[]
  inspections         Inspection[]
  images              Image[]
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams     Team[]
  users     User[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Team {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  departmentId      String?      @db.Uuid
  name              String
  code              String
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members           TeamMember[]
  siteVisits        SiteVisit[]
  assignedDefects   Defect[]     @relation("DefectAssignedTeam")
  assignedToDefects Defect[]     @relation("DefectAssignedToTeam")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  tenantId                String                   @db.Uuid
  departmentId            String?                  @db.Uuid
  email                   String                   @unique
  name                    String
  passwordHash            String
  role                    UserRole
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamMemberships         TeamMember[]
  siteVisitUsers          SiteVisitUser[]
  createdVisits           SiteVisit[]              @relation("SiteVisitCreatedBy")
  validatedVisits         SiteVisit[]              @relation("SiteVisitValidatedBy")
  createdAssets           Asset[]                  @relation("AssetCreatedBy")
  siteVisitAssetsAdded    SiteVisitAsset[]         @relation("SiteVisitAssetAddedBy")
  createdInspects         Inspection[]             @relation("InspectionCreatedBy")
  createdImages           Image[]                  @relation("ImageCreatedBy")
  defectTimelineEntries   DefectTimelineEntry[]    @relation("DefectTimelineCreatedBy")
  assignedDefects         Defect[]                 @relation("DefectAssignedUser")
  assignedToDefects       Defect[]                 @relation("DefectAssignedToUser")
  verifiedDefects         Defect[]                 @relation("DefectVerifiedByUser")
  maintainedDefects       Defect[]                 @relation("DefectMaintainedByUser")
  closureVerifiedDefects  Defect[]                 @relation("DefectClosureVerifiedByUser")
  organizationMemberships OrganizationMembership[]
  projectMemberships      ProjectMembership[]
  siteVisitParticipants   SiteVisitParticipant[]

  @@index([tenantId])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Organization {
  id                     String                   @id @default(uuid()) @db.Uuid
  name                   String
  code                   String?                  @unique
  type                   OrganizationType
  parentOrganizationId   String?                  @db.Uuid
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  parentOrganization     Organization?            @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id], onDelete: SetNull)
  childOrganizations     Organization[]           @relation("OrganizationHierarchy")
  memberships            OrganizationMembership[]
  capabilities           OrganizationCapability[]
  branches               Branch[]
  clientProjects         Project[]                @relation("ProjectClientOrganization")
  workPackageAssignments WorkPackageAssignment[]
  siteVisits             SiteVisit[]

  @@index([type])
  @@index([parentOrganizationId])
}

model OrganizationCapability {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  capability     OrganizationCapabilityType
  isActive       Boolean                    @default(true)
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capability])
  @@index([organizationId])
  @@index([capability])
}

model OrganizationMembership {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String                     @db.Uuid
  organizationId String                     @db.Uuid
  role           OrganizationMembershipRole
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String?
  region         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainheads      Mainhead[]
  projects       Project[]
  siteVisits     SiteVisit[]

  @@index([organizationId])
}

model Mainhead {
  id           String        @id @default(uuid()) @db.Uuid
  branchId     String        @db.Uuid
  name         String
  code         String?
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  projects     Project[]
  workPackages WorkPackage[]
  siteVisits   SiteVisit[]

  @@index([branchId])
  @@index([isActive])
}

model Project {
  id                   String              @id @default(uuid()) @db.Uuid
  branchId             String              @db.Uuid
  mainheadId           String?             @db.Uuid
  clientOrganizationId String?             @db.Uuid
  name                 String
  code                 String?             @unique
  description          String?
  status               ProjectStatus       @default(DRAFT)
  operationalDomain    OperationalDomain?
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mainhead             Mainhead?           @relation(fields: [mainheadId], references: [id], onDelete: SetNull)
  clientOrganization   Organization?       @relation("ProjectClientOrganization", fields: [clientOrganizationId], references: [id], onDelete: SetNull)
  memberships          ProjectMembership[]
  workPackages         WorkPackage[]
  siteVisits           SiteVisit[]

  @@index([branchId])
  @@index([mainheadId])
  @@index([operationalDomain])
  @@index([status])
}

model ProjectMembership {
  id        String                @id @default(uuid()) @db.Uuid
  projectId String                @db.Uuid
  userId    String                @db.Uuid
  role      ProjectMembershipRole
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model WorkPackage {
  id                String                  @id @default(uuid()) @db.Uuid
  projectId         String                  @db.Uuid
  mainheadId        String?                 @db.Uuid
  name              String
  code              String?
  area              String?
  mainhead          String?
  description       String?
  status            WorkPackageStatus       @default(DRAFT)
  operationalDomain OperationalDomain?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  project           Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mainheadRecord    Mainhead?               @relation(fields: [mainheadId], references: [id], onDelete: SetNull)
  assignments       WorkPackageAssignment[]
  siteVisits        SiteVisit[]

  @@index([projectId])
  @@index([mainheadId])
  @@index([operationalDomain])
  @@index([status])
}

model WorkPackageAssignment {
  id             String                    @id @default(uuid()) @db.Uuid
  workPackageId  String                    @db.Uuid
  organizationId String                    @db.Uuid
  role           WorkPackageAssignmentRole
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  workPackage    WorkPackage               @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workPackageId, organizationId])
}

model Substation {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  name       String
  code       String
  location   String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets     Asset[]
  siteVisits SiteVisit[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model AssetType {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  name                String
  code                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets              Asset[]
  inspectionTemplates InspectionTemplate[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Asset {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @db.Uuid
  substationId         String           @db.Uuid
  assetTypeId          String           @db.Uuid
  assetCode            String           @map("code")
  name                 String?
  latitude             Float?
  longitude            Float?
  metadata             Json?
  status               AssetStatus      @default(ACTIVE)
  createdDuringVisitId String?          @db.Uuid
  createdByUserId      String?          @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  substation           Substation       @relation(fields: [substationId], references: [id], onDelete: Cascade)
  assetType            AssetType        @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  createdDuringVisit   SiteVisit?       @relation(fields: [createdDuringVisitId], references: [id], onDelete: SetNull)
  createdBy            User?            @relation("AssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  siteVisitAssets      SiteVisitAsset[]
  inspections          Inspection[]
  images               Image[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@index([substationId])
  @@index([assetTypeId])
  @@index([createdDuringVisitId])
  @@index([createdByUserId])
}

model SiteVisit {
  id                    String                     @id @default(uuid()) @db.Uuid
  tenantId              String                     @db.Uuid
  teamId                String                     @db.Uuid
  substationId          String                     @db.Uuid
  createdByUserId       String                     @db.Uuid
  validatedByUserId     String?                    @db.Uuid
  organizationId        String?                    @db.Uuid
  branchId              String?                    @db.Uuid
  mainheadId            String?                    @db.Uuid
  projectId             String?                    @db.Uuid
  workPackageId         String?                    @db.Uuid
  status                SiteVisitStatus            @default(ACTIVE)
  cycleNumber           Int?
  visitType             SiteVisitType?
  operationalDomain     OperationalDomain?
  mainhead              String?
  pencawangCode         String?
  pencawangName         String?
  functionalLocation    String?
  checkInLatitude       Float?
  checkInLongitude      Float?
  checkInAccuracyMeters Float?
  checkInCapturedAt     DateTime?
  validationStatus      SiteVisitValidationStatus?
  validatedAt           DateTime?
  validationSummary     String?
  feederId              String?
  feederRouteId         String?
  gisGeometryVersion    String?
  completionNotes       String?
  cancelReason          String?
  startedAt             DateTime                   @default(now())
  completedAt           DateTime?
  endedAt               DateTime?
  notes                 String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team                  Team                       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  substation            Substation                 @relation(fields: [substationId], references: [id], onDelete: Restrict)
  createdBy             User                       @relation("SiteVisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  validatedBy           User?                      @relation("SiteVisitValidatedBy", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  organization          Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branch                Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  mainheadRecord        Mainhead?                  @relation(fields: [mainheadId], references: [id], onDelete: SetNull)
  project               Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workPackage           WorkPackage?               @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  users                 SiteVisitUser[]
  participants          SiteVisitParticipant[]
  createdAssets         Asset[]
  visitAssets           SiteVisitAsset[]
  inspections           Inspection[]
  images                Image[]

  @@index([tenantId])
  @@index([teamId, status])
  @@index([substationId])
  @@index([validatedByUserId])
  @@index([organizationId])
  @@index([branchId])
  @@index([mainheadId])
  @@index([projectId])
  @@index([workPackageId])
  @@index([cycleNumber])
  @@index([visitType])
  @@index([operationalDomain])
  @@index([validationStatus])
  @@index([feederId])
  @@index([feederRouteId])
  @@index([completedAt])
}

model SiteVisitUser {
  id          String    @id @default(uuid()) @db.Uuid
  siteVisitId String    @db.Uuid
  userId      String    @db.Uuid
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  siteVisit   SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteVisitId, userId])
  @@index([userId])
}

model SiteVisitParticipant {
  id          String                   @id @default(uuid()) @db.Uuid
  siteVisitId String                   @db.Uuid
  userId      String                   @db.Uuid
  role        SiteVisitParticipantRole
  joinedAt    DateTime                 @default(now())
  leftAt      DateTime?
  isActive    Boolean                  @default(true)
  siteVisit   SiteVisit                @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteVisitId, userId])
  @@index([userId])
}

model SiteVisitAsset {
  id            String    @id @default(uuid()) @db.Uuid
  siteVisitId   String    @db.Uuid
  assetId       String    @db.Uuid
  addedByUserId String?   @db.Uuid
  source        String?
  notes         String?
  addedAt       DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  siteVisit     SiteVisit @relation(fields: [siteVisitId], references: [id], onDelete: Cascade)
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  addedBy       User?     @relation("SiteVisitAssetAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([siteVisitId, assetId])
  @@index([assetId])
  @@index([addedByUserId])
  @@index([siteVisitId, addedAt])
}

model InspectionTemplate {
  id          String                      @id @default(uuid()) @db.Uuid
  tenantId    String                      @db.Uuid
  assetTypeId String                      @db.Uuid
  version     Int
  name        String
  status      InspectionTemplateStatus    @default(DRAFT)
  isActive    Boolean                     @default(false)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  publishedAt DateTime?
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetType   AssetType                   @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  sections    InspectionTemplateSection[]
  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@unique([assetTypeId, version])
  @@index([tenantId])
  @@index([assetTypeId, isActive])
}

model InspectionTemplateSection {
  id          String                   @id @default(uuid()) @db.Uuid
  templateId  String                   @db.Uuid
  title       String
  description String?
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  template    InspectionTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items       InspectionTemplateItem[]

  @@index([templateId, sortOrder])
}

model InspectionTemplateItem {
  id              String                    @id @default(uuid()) @db.Uuid
  templateId      String                    @db.Uuid
  sectionId       String                    @db.Uuid
  key             String
  label           String
  helperText      String?
  inputType       InspectionItemInputType
  isRequired      Boolean                   @default(false)
  isActive        Boolean                   @default(true)
  isDefectTrigger Boolean                   @default(true)
  severity        DefectSeverity            @default(MEDIUM)
  sortOrder       Int                       @default(0)
  optionsJson     Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  template        InspectionTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section         InspectionTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  results         InspectionResult[]

  @@unique([templateId, key])
  @@index([sectionId, sortOrder])
}

model Inspection {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @db.Uuid
  siteVisitId      String                     @db.Uuid
  assetId          String                     @db.Uuid
  templateId       String                     @db.Uuid
  createdByUserId  String                     @db.Uuid
  inspectionCycle  Int                        @default(1)
  completionStatus InspectionCompletionStatus @default(DRAFT)
  submittedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteVisit        SiteVisit                  @relation(fields: [siteVisitId], references: [id], onDelete: Restrict)
  asset            Asset                      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  template         InspectionTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  results          InspectionResult[]
  itemResults      InspectionItemResult[]
  images           Image[]
  inspectionImages InspectionImage[]

  @@index([tenantId])
  @@index([siteVisitId])
  @@index([assetId])
  @@index([templateId])
}

model InspectionImage {
  id           String     @id @default(uuid()) @db.Uuid
  inspectionId String     @db.Uuid
  url          String
  filename     String
  mimeType     String?
  sizeBytes    Int?
  latitude     Float?
  longitude    Float?
  timestamp    DateTime?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([inspectionId, createdAt])
}

model InspectionItemResult {
  id              String                    @id @default(uuid()) @db.Uuid
  inspectionId    String                    @db.Uuid
  checklistItemId String?                   @db.Uuid
  label           String
  result          InspectionItemResultValue
  remark          String?
  isDefect        Boolean                   @default(false)
  severity        DefectSeverity?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  inspection      Inspection                @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defect          Defect?

  @@index([inspectionId])
  @@index([checklistItemId])
}

model Defect {
  id                       String                 @id @default(uuid()) @db.Uuid
  inspectionItemResultId   String                 @unique @db.Uuid
  assignedUserId           String?                @db.Uuid
  assignedTeamId           String?                @db.Uuid
  assignedToUserId         String?                @db.Uuid
  assignedToTeamId         String?                @db.Uuid
  verifiedByUserId         String?                @db.Uuid
  maintainedByUserId       String?                @db.Uuid
  closureVerifiedByUserId  String?                @db.Uuid
  status                   DefectStatus           @default(OPEN)
  severity                 DefectSeverity         @default(MEDIUM)
  lifecycleStatus          DefectLifecycleStatus?
  resolutionOutcome        ResolutionOutcome?
  actionRemark             String?
  dueDate                  DateTime?
  resolvedAt               DateTime?
  closedAt                 DateTime?
  assignedAt               DateTime?
  verifiedAt               DateTime?
  maintainedAt             DateTime?
  verificationRemarks      String?
  verificationNotes        String?
  maintenanceNotes         String?
  closureVerifiedAt        DateTime?
  closureRemarks           String?
  closureVerificationNotes String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  inspectionItemResult     InspectionItemResult   @relation(fields: [inspectionItemResultId], references: [id], onDelete: Cascade)
  assignedUser             User?                  @relation("DefectAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeam             Team?                  @relation("DefectAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedToUser           User?                  @relation("DefectAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedToTeam           Team?                  @relation("DefectAssignedToTeam", fields: [assignedToTeamId], references: [id], onDelete: SetNull)
  verifiedByUser           User?                  @relation("DefectVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  maintainedByUser         User?                  @relation("DefectMaintainedByUser", fields: [maintainedByUserId], references: [id], onDelete: SetNull)
  closureVerifiedByUser    User?                  @relation("DefectClosureVerifiedByUser", fields: [closureVerifiedByUserId], references: [id], onDelete: SetNull)
  timelineEntries          DefectTimelineEntry[]

  @@index([assignedUserId])
  @@index([assignedTeamId])
  @@index([assignedToUserId])
  @@index([assignedToTeamId])
  @@index([verifiedByUserId])
  @@index([maintainedByUserId])
  @@index([closureVerifiedByUserId])
  @@index([lifecycleStatus])
  @@index([resolutionOutcome])
  @@index([assignedAt])
  @@index([maintainedAt])
  @@index([dueDate])
  @@index([status, dueDate])
}

model DefectTimelineEntry {
  id                    String                  @id @default(uuid()) @db.Uuid
  defectId              String                  @db.Uuid
  type                  DefectTimelineEventType
  fromStatus            DefectStatus?
  toStatus              DefectStatus?
  fromLifecycleStatus   DefectLifecycleStatus?
  toLifecycleStatus     DefectLifecycleStatus?
  fromResolutionOutcome ResolutionOutcome?
  toResolutionOutcome   ResolutionOutcome?
  comment               String?
  createdByUserId       String?                 @db.Uuid
  createdAt             DateTime                @default(now())
  defect                Defect                  @relation(fields: [defectId], references: [id], onDelete: Cascade)
  createdBy             User?                   @relation("DefectTimelineCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([defectId, createdAt])
  @@index([createdByUserId])
}

model InspectionResult {
  id             String                 @id @default(uuid()) @db.Uuid
  inspectionId   String                 @db.Uuid
  templateItemId String                 @db.Uuid
  valueText      String?
  valueNumber    Decimal?               @db.Decimal(18, 4)
  valueBoolean   Boolean?
  valueDate      DateTime?              @db.Date
  valueDateTime  DateTime?
  valueJson      Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  inspection     Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem   InspectionTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  images         Image[]

  @@unique([inspectionId, templateItemId])
  @@index([templateItemId])
}

model Image {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  siteVisitId        String?           @db.Uuid
  assetId            String?           @db.Uuid
  inspectionId       String?           @db.Uuid
  inspectionResultId String?           @db.Uuid
  createdByUserId    String?           @db.Uuid
  fileName           String
  storageKey         String
  contentType        String?
  url                String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteVisit          SiteVisit?        @relation(fields: [siteVisitId], references: [id], onDelete: SetNull)
  asset              Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  inspection         Inspection?       @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  inspectionResult   InspectionResult? @relation(fields: [inspectionResultId], references: [id], onDelete: SetNull)
  createdBy          User?             @relation("ImageCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([siteVisitId])
  @@index([assetId])
  @@index([inspectionId])
  @@index([inspectionResultId])
}
