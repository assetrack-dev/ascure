NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Maps JavaScript API key for the Asset Map page (/map). When unset, the
# map falls back to OpenStreetMap/Leaflet. Use a key with the "Maps JavaScript
# API" enabled and an HTTP-referrer restriction for your web domain (do NOT
# reuse the Android-restricted mobile key in production).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
