{
  "name": "@ascure/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "test": "jest --config test/jest-unit.json && jest --config test/jest-e2e.json --runInBand",
