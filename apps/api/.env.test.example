# Copy to apps/api/.env.test (gitignored) and point at a LOCAL throwaway Postgres.
# The e2e suite RESETS + RE-SEEDS this database on every run — never point it at
# dev or prod data. CI injects DATABASE_URL via the workflow instead of this file.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ascure_test?schema=public"
JWT_SECRET="test-jwt-secret-not-for-production"
NODE_ENV="test"
