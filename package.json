{
  "name": "ascure",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @ascure/api",
    "start": "npm run start --workspace @ascure/api",
    "start:dev": "npm run start:dev --workspace @ascure/api",
    "admin-web:dev": "npm run dev --workspace @ascure/admin-web",
    "admin-web:build": "npm run build --workspace @ascure/admin-web",
    "admin-web:start": "npm run start --workspace @ascure/admin-web",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2",
    "expo": "~55.0.17",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "devDependencies": {
    "prisma": "^6.7.0",
    "tsx": "^4.19.4"
  }
}
